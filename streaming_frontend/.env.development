# Dev-only CRA settings to allow the React dev server to accept cloud preview hosts
# NOTE: Do NOT copy these into production env files; they are intended for local/preview development only.

HOST=0.0.0.0
DANGEROUSLY_DISABLE_HOST_CHECK=true
PORT=3000

# Optional: Backend API base URL for development/preview.
# If set, this should point at the backend preview origin (otherwise defaults to http://localhost:3001).
# REACT_APP_API_BASE=https://vscode-internal-31833-beta.beta01.cloud.kavia.ai:3001
